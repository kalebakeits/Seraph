{
  "name": "seraph.app",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "dev": "watchman watch-del-all 2>/dev/null; adb reverse tcp:8081 tcp:8081 2>/dev/null; npx expo start --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "db:generate": "drizzle-kit generate && npm run db:sync-native",
    "db:sync-native": "cat src/services/database/drizzle/migrations/*.sql | sed 's/--> statement-breakpoint//g' | sed 's/`//g' | sed 's/\"//g' > ../Seraph.Native/src/commonMain/sqldelight/com/seraph/native/db/1.sqm",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/hooks": "^100.1.0",
    "@react-native-community/slider": "^5.1.2",
    "@react-navigation/bottom-tabs": "^7.8.7",
    "@react-navigation/native": "^7.1.22",
    "@react-navigation/native-stack": "^7.8.5",
    "@sentry/react-native": "^8.6.0",
    "@shopify/react-native-skia": "^2.4.6",
    "@tanstack/react-query": "^5.90.11",
    "drizzle-orm": "^0.45.1",
    "expo": "~54.0.25",
    "expo-blur": "~15.0.8",
    "expo-document-picker": "~14.0.8",
    "expo-localization": "^55.0.9",
    "expo-notifications": "^0.32.15",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.8",
    "i18next": "^25.10.10",
    "react": "19.1.0",
    "react-i18next": "^16.6.6",
    "react-native": "0.81.5",
    "react-native-calendars": "^1.1313.0",
    "react-native-date-picker": "^5.0.13",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-reanimated": "^4.2.3",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "babel-plugin-inline-import": "^3.0.0",
    "babel-preset-expo": "^55.0.12",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.58.0"
  },
  "private": true
}
