{
  "expo": {
    "name": "Seraph",
    "slug": "Seraph",
    "version": "0.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#150029"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "This app uses Bluetooth to connect to your fitness device and track your health metrics.",
        "NSBluetoothPeripheralUsageDescription": "This app uses Bluetooth to connect to your fitness device and track your health metrics.",
        "UIBackgroundModes": ["bluetooth-central", "processing"],
        "NSUserNotificationsUsageDescription": "This app uses notifications to alert you about important health metrics and device updates."
      },
      "bundleIdentifier": "com.seraph.app"
    },
    "android": {
      "package": "com.seraph.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_BLUETOOTH"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "assetBundlePatterns": ["assets/fonts/*"],
    "plugins": [
      "./plugins/withBluetoothPermissions.js",
      ["expo-sqlite", { "useSQLCipher": true }],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#ffffff"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "kaleba"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "82489564-e5ca-4494-a5be-6198e430a923"
      }
    }
  }
}
