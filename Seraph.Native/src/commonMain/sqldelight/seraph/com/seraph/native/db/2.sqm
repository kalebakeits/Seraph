CREATE TABLE daily_aggregations_new (
    date TEXT PRIMARY KEY NOT NULL,
    steps INTEGER,
    avg_hr REAL,
    rhr REAL,
    max_hr REAL,
    max_hr_validated INTEGER,
    hrv_rmssd REAL,
    strain REAL,
    active_minutes INTEGER,
    recovery REAL,
    skin_temp REAL,
    sleep_need REAL,
    sleep_need_factors TEXT,
    hr_sample_count INTEGER NOT NULL DEFAULT 0,
    trimp REAL,
    ctl REAL,
    atl REAL,
    hrv_windows TEXT,
    daily_stress INTEGER,
    baseline_waking_hrv REAL,
    finalized INTEGER DEFAULT 0 NOT NULL,
    last_agg_ts INTEGER,
    updated_at INTEGER NOT NULL,
    baseline_hrv REAL,
    baseline_rhr REAL
);

INSERT INTO daily_aggregations_new (
    date,
    steps,
    avg_hr,
    rhr,
    max_hr,
    max_hr_validated,
    hrv_rmssd,
    strain,
    active_minutes,
    recovery,
    skin_temp,
    sleep_need,
    sleep_need_factors,
    hr_sample_count,
    trimp,
    ctl,
    atl,
    hrv_windows,
    daily_stress,
    baseline_waking_hrv,
    finalized,
    last_agg_ts,
    updated_at,
    baseline_hrv,
    baseline_rhr
)
SELECT
    date,
    steps,
    avg_hr,
    rhr,
    max_hr,
    max_hr_validated,
    hrv_rmssd,
    strain,
    active_minutes,
    recovery,
    skin_temp,
    sleep_need,
    NULL,
    hr_sample_count,
    trimp,
    ctl,
    atl,
    hrv_windows,
    daily_stress,
    baseline_waking_hrv,
    finalized,
    last_agg_ts,
    updated_at,
    baseline_hrv,
    baseline_rhr
FROM daily_aggregations;

DROP TABLE daily_aggregations;
ALTER TABLE daily_aggregations_new RENAME TO daily_aggregations;
