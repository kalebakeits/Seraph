CREATE TABLE app_parameters (
	key TEXT PRIMARY KEY NOT NULL,
	value TEXT NOT NULL,
	updated_at INTEGER NOT NULL
);

CREATE TABLE daily_aggregations (
	date TEXT PRIMARY KEY NOT NULL,
	steps INTEGER,
	avg_hr REAL,
	rhr REAL,
	max_hr REAL,
	max_hr_validated INTEGER,
	hrv_rmssd REAL,
	strain REAL,
	active_minutes INTEGER,
	recovery REAL,
	skin_temp REAL,
	sleep_need REAL,
	sleep_debt_adj REAL,
	sleep_strain_adj REAL,
	hr_sample_count INTEGER NOT NULL DEFAULT 0,
	trimp REAL,
	ctl REAL,
	atl REAL,
	hrv_windows TEXT,
	daily_stress INTEGER,
	baseline_waking_hrv REAL,
	finalized INTEGER DEFAULT 0 NOT NULL,
	last_agg_ts INTEGER,
	updated_at INTEGER NOT NULL,
	baseline_hrv REAL,
	baseline_rhr REAL
);

CREATE TABLE sleep_events (
	id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
	date TEXT NOT NULL,
	start_ts INTEGER NOT NULL,
	end_ts INTEGER NOT NULL,
	duration_minutes INTEGER NOT NULL,
	awake_minutes INTEGER NOT NULL DEFAULT 0,
	pending_awake_ms INTEGER NOT NULL DEFAULT 0,
	avg_hr REAL,
	hrv_rmssd REAL,
	hr_samples TEXT,
	stage_samples TEXT,
	hr_sum REAL NOT NULL DEFAULT 0.0,
	hr_count INTEGER NOT NULL DEFAULT 0,
	hrv_sq_sum REAL NOT NULL DEFAULT 0.0,
	hrv_count INTEGER NOT NULL DEFAULT 0,
	rhr_min INTEGER,
	skin_temp_sum REAL NOT NULL DEFAULT 0.0,
	skin_temp_count INTEGER NOT NULL DEFAULT 0,
	finalized INTEGER DEFAULT 0 NOT NULL,
	sleep_edited INTEGER DEFAULT 0 NOT NULL,
	is_manual INTEGER DEFAULT 0 NOT NULL,
	sleep_score INTEGER,
	timezone TEXT,
	created_at INTEGER NOT NULL
);

CREATE INDEX sleep_events_date_idx ON sleep_events (date);

CREATE TABLE activity_events (
	id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
	date TEXT NOT NULL,
	start_ts INTEGER NOT NULL,
	end_ts INTEGER NOT NULL,
	duration_minutes INTEGER NOT NULL,
	avg_hr REAL,
	max_hr REAL,
	steps INTEGER,
	type TEXT DEFAULT 'unknown' NOT NULL,
	hr_samples TEXT,
	zone_seconds TEXT,
	threshold_hr REAL,
	trimp REAL,
	hr_sum REAL NOT NULL DEFAULT 0.0,
	hr_count INTEGER NOT NULL DEFAULT 0,
	finalized INTEGER DEFAULT 0 NOT NULL,
	is_manual INTEGER DEFAULT 0 NOT NULL,
	timezone TEXT,
	created_at INTEGER NOT NULL
);

CREATE INDEX activity_events_date_idx ON activity_events (date);

CREATE TABLE notifications (
	id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
	type TEXT NOT NULL,
	payload TEXT,
	read INTEGER NOT NULL DEFAULT 0,
	entity_type TEXT,
	entity_id INTEGER,
	created_at INTEGER NOT NULL
);

CREATE INDEX notifications_created_idx ON notifications (created_at DESC);
CREATE UNIQUE INDEX notifications_entity_idx ON notifications (entity_type, entity_id) WHERE entity_type IS NOT NULL AND entity_id IS NOT NULL;

CREATE TABLE habit_definitions (
	id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
	name_key TEXT,
	name_custom TEXT,
	type TEXT NOT NULL,
	unit TEXT,
	default_quantity REAL,
	step REAL,
	is_manual INTEGER NOT NULL DEFAULT 0,
	is_active INTEGER NOT NULL DEFAULT 0,
	sort_order INTEGER NOT NULL DEFAULT 0,
	created_at INTEGER NOT NULL
);

CREATE INDEX habit_definitions_active_idx ON habit_definitions (is_active);

CREATE TABLE habit_logs (
	id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
	habit_id INTEGER NOT NULL,
	date TEXT NOT NULL,
	quantity REAL NOT NULL,
	time_of_day TEXT,
	created_at INTEGER NOT NULL
);

CREATE UNIQUE INDEX habit_logs_habit_date_idx ON habit_logs (habit_id, date);
CREATE INDEX habit_logs_date_idx ON habit_logs (date);
