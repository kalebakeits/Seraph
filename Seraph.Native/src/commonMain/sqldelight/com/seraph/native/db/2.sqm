CREATE TABLE habit_definitions (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    name_key TEXT,
    name_custom TEXT,
    type TEXT NOT NULL,
    unit TEXT,
    default_quantity REAL,
    is_manual INTEGER NOT NULL DEFAULT 0,
    is_active INTEGER NOT NULL DEFAULT 0,
    sort_order INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL
);

CREATE INDEX habit_definitions_active_idx ON habit_definitions (is_active);

CREATE TABLE habit_logs (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    habit_id INTEGER NOT NULL,
    date TEXT NOT NULL,
    quantity REAL NOT NULL,
    time_of_day TEXT,
    created_at INTEGER NOT NULL
);

CREATE UNIQUE INDEX habit_logs_habit_date_idx ON habit_logs (habit_id, date);
CREATE INDEX habit_logs_date_idx ON habit_logs (date);
